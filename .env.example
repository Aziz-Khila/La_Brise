# Owner admin at /admin. Without the first two values, /admin does not exist.
ADMIN_PASSWORD=
# Long random string; changing it logs every device out.
ADMIN_SESSION_SECRET=

# Where "Publier" commits. Without these, publishing writes the local files (npm run dev only).
# Fine-grained token limited to this repository, permission "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=Aziz-Khila/La-Brise
GITHUB_BRANCH=main
